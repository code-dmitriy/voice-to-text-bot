# ===== Обязательно =====
# Токен бота от @BotFather (выглядит как 123456789:AAH...)
BOT_TOKEN=

# Authorization key проекта GigaChat API на developers.sber.ru (длинная строка, часто с == на конце).
# Им бот и расшифровывает голосовые, и делает «Кратко»/«Задачи».
GIGACHAT_AUTH_KEY=

# ===== Запасной вариант для «Кратко»/«Задачи», если GigaChat не ответил (можно оставить пустым) =====
# Ключ OpenRouter (начинается с sk-or-)
OPENROUTER_API_KEY=

# ===== Необязательно (пусто = значение по умолчанию) =====
# Telegram id админов через запятую: у них нет лимитов и есть команда /stats
ADMIN_IDS=
# Бесплатных минут в сутки на человека (по умолчанию 15)
DAILY_MINUTES_PER_USER=
# Максимум минут в одной записи (по умолчанию 30)
MAX_AUDIO_MINUTES=
# Общий потолок минут на всех за месяц, 0 = без потолка
MONTHLY_MINUTES_TOTAL=
# Нажатий «Кратко»/«Задачи» в сутки: на человека (20) и на всех (1000)
LLM_PER_USER_PER_DAY=
LLM_TOTAL_PER_DAY=
# Список моделей OpenRouter через запятую (по умолчанию бесплатные, см. bot/config.py)
OPENROUTER_MODELS=
# Модели GigaChat: для аудио (через запятую, по очереди) и для текста
GIGACHAT_AUDIO_MODELS=
GIGACHAT_TEXT_MODEL=
GIGACHAT_SCOPE=
TRANSCRIPT_TTL_DAYS=
DB_PATH=
LOG_LEVEL=
